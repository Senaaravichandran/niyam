# Optional. With a key, the Extractor and Author use Claude; without one they use the
# deterministic rule-based path. The console and logs always say which path ran.
ANTHROPIC_API_KEY=

# Optional. Model for the LLM path (default: claude-opus-5-5).
NIYAM_LLM_MODEL=claude-opus-5-5

# Recommended in any shared deployment. HMAC secret for two-person approval tokens.
# Without it a development secret is used and the console says so.
NIYAM_APPROVAL_SECRET=

# Optional. Canonical site URL for metadata.
NEXT_PUBLIC_SITE_URL=
